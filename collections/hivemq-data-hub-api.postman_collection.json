  "info": {
    "_postman_id": "7e1a54de-8da2-4d53-9a26-4b016f12522e",
    "name": "HiveMQ REST Data Hub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for administering a HiveMQ broker. Endpoints cover MQTT\nclient listing, search, disconnect; session invalidation; backups;\ndiagnostic archives; trace recordings; and Data Hub schemas, policies,\nand modules. Endpoint shapes inferred from the public HiveMQ REST API\ndocumentation at docs.hivemq.com/hivemq/latest/rest-api/.\n\n\nContact Support:\n Name: HiveMQ Documentation",
      "type": "text/plain"
    }
  }
